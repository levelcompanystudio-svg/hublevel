# HubLevel server - env privado (nunca commitar valores reais, nunca usar prefixo VITE_ aqui).
# Este arquivo roda apenas em Node, nunca no browser.

NODE_ENV=development
PORT=4000

# Supabase (mesmo projeto do frontend, mas usando a service role - uso interno deste servidor)
SUPABASE_URL=https://SUPABASE_PROJECT_REF_DEV.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_DEV

# Meta Ads - opcional neste Bloco 1 (nenhuma chamada real e feita ainda). Necessario a partir do
# bloco que implementar validateConnection/listAccounts/etc de verdade no metaProvider.
META_APP_ID=META_APP_ID_PLACEHOLDER
META_APP_SECRET=META_APP_SECRET_PLACEHOLDER

# Google Ads - opcional neste Bloco 1, pelo mesmo motivo acima.
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_PLACEHOLDER
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_PLACEHOLDER
