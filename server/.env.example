# HubLevel server - env privado (nunca commitar valores reais, nunca usar prefixo VITE_ aqui).
# Este arquivo roda apenas em Node, nunca no browser.

NODE_ENV=development
PORT=4000

# Supabase (mesmo projeto do frontend, mas usando a service role - uso interno deste servidor)
SUPABASE_URL=https://SUPABASE_PROJECT_REF_DEV.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_DEV

# Meta Ads (Bloco 2: integracao real) - token do SYSTEM USER do Business Meta, nunca token de
# usuario individual. Precisa de permissao ads_read (ou ads_management se for gerenciar campanhas
# no futuro) nas contas de anuncio que devem ser sincronizadas.
META_SYSTEM_USER_TOKEN=META_SYSTEM_USER_TOKEN_PLACEHOLDER
# Usados apenas para calcular appsecret_proof (recomendacao de seguranca da Graph API). Opcionais:
# sem eles o cliente Meta funciona normalmente, so sem esse reforco de seguranca.
META_APP_ID=META_APP_ID_PLACEHOLDER
META_APP_SECRET=META_APP_SECRET_PLACEHOLDER
META_API_VERSION=v21.0

# Google Ads - ainda apenas estrutural neste bloco, nenhuma chamada real e feita.
GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID_PLACEHOLDER
GOOGLE_CLIENT_SECRET=GOOGLE_CLIENT_SECRET_PLACEHOLDER

# CORS - origin do frontend em producao (dominio publico real, sem barra final). Em
# desenvolvimento, http://localhost:5173 ja e permitido automaticamente, sem precisar desta
# variavel. Nunca usar "*" aqui nem no codigo - a allowlist e sempre explicita.
FRONTEND_URL=https://hublevel-production.up.railway.app
